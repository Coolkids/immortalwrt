{
	"luci-app-qos-gargoyle": {
		"description": "Grant access to LuCI Gargoyle QoS",
		"read": {
			"uci": [ "qos_gargoyle", "luci", "network", "wireless" ],
			"ubus": {
				"network": [ "get_proto_handlers" ],
				"network.interface": [ "dump" ],
				"luci-rpc": [ "getBoardJSON", "getHostHints", "getNetworkDevices", "getWirelessDevices" ],
				"luci": [ "setInitAction" ]
			},
			"file": {
				"/etc/init.d/qos_gargoyle": [ "read", "exec" ],
				"/proc/modules": [ "read" ],
				"/tmp/qosmon.status": [ "read" ],
				"/usr/sbin/iptables": [ "exec" ],
				"/sbin/tc": [ "exec" ],
				"/usr/sbin/tc": [ "exec" ]
			}
		},
		"write": {
			"uci": [ "qos_gargoyle" ],
			"ubus": {
				"luci": [ "setInitAction" ]
			}
		}
	}
}
