#!/bin/sh /etc/rc.common
# Copyright (C) 2026 OpenWrt.org

START=95
STOP=10

USE_PROCD=1

PROG=/usr/bin/valkey-server
CONF=/etc/valkey/valkey.conf

ensure_valkey_user() {
	# Create Valkey user/group before configuration validation.
	if ! user_exists valkey; then
		user_add valkey 450 450 "valkey" /var/lib/valkey /bin/false || {
			echo "failed to create valkey user"
			return 1
		}
	fi

	return 0
}

prepare_valkey_instance() {
	local cfg="$1"
	local dir logfile logdir

	config_get dir "$cfg" dir "/var/lib/valkey"
	config_get logfile "$cfg" logfile "/var/log/valkey.log"

	# The "directory" validator requires the directory to exist.
	if [ ! -d "${dir}" ]; then
		mkdir -p "${dir}" || {
			echo "failed to create Valkey data directory: ${dir}"
			return 1
		}
	fi

	# Make sure Valkey can access its data directory.
	chown -R valkey "${dir}" || {
		echo "failed to set ownership of Valkey data directory: ${dir}"
		return 1
	}

	# Prepare logfile directory.
	logdir="$(dirname "${logfile}")"

	if [ ! -d "${logdir}" ]; then
		mkdir -p "${logdir}" || {
			echo "failed to create Valkey log directory: ${logdir}"
			return 1
		}
	fi

	# Create logfile so the Valkey user can write to it.
	touch "${logfile}" || {
		echo "failed to create Valkey log file: ${logfile}"
		return 1
	}

	chown valkey "${logfile}" || {
		echo "failed to set ownership of Valkey log file: ${logfile}"
		return 1
	}

	return 0
}

validate_valkey_section() {
	local cfg="$1"

	# The validation environment must exist before
	# uci_validate_section is called.
	ensure_valkey_user || return 1
	prepare_valkey_instance "${cfg}" || return 1

	uci_validate_section valkey instance "${cfg}" \
		'enabled:bool:1' \
		'port:port:6379' \
		'bind:host:127.0.0.1' \
		'dir:directory:/var/lib/valkey' \
		'logfile:string:/var/log/valkey.log' \
		'daemonize:bool:0' \
		'maxmemory:string' \
		'maxmemory_policy:string' \
		'save:list(string)' \
		'appendonly:bool:0' \
		'appendfilename:string:appendonly.aof'
}

valkey_instance() {
	local cfg="$1"
	local enabled port bind dir logfile daemonize maxmemory maxmemory_policy save appendonly appendfilename

	# Ensure the user and directories exist before validation.
	ensure_valkey_user || return 1
	prepare_valkey_instance "${cfg}" || return 1

	validate_valkey_section "${cfg}" || {
		echo "validation failed"
		return 1
	}

	[ "${enabled}" = "0" ] && return 0

	# Generate runtime config.
	local config_file="/var/etc/valkey-${cfg}.conf"

	mkdir -p /var/etc || {
		echo "failed to create /var/etc"
		return 1
	}

	if [ -f "$CONF" ]; then
		grep -v "^port\|^bind\|^dir\|^logfile\|^daemonize\|^maxmemory\|^save\|^appendonly\|^appendfilename" \
			"$CONF" > "$config_file"
	else
		> "$config_file"
	fi

	cat >> "$config_file" <<-EOF
		port ${port}
		bind ${bind}
		dir ${dir}
		logfile ${logfile}
		daemonize no
	EOF

	[ -n "${maxmemory}" ] &&
		echo "maxmemory ${maxmemory}" >> "$config_file"

	[ -n "${maxmemory_policy}" ] &&
		echo "maxmemory-policy ${maxmemory_policy}" >> "$config_file"

	# Add save directives.
	if [ -n "${save}" ]; then
		echo "save ${save}" >> "$config_file"
	fi

	if [ "${appendonly}" = "1" ]; then
		echo "appendonly yes" >> "$config_file"

		[ -n "${appendfilename}" ] &&
			echo "appendfilename ${appendfilename}" >> "$config_file"
	fi

	procd_open_instance
	procd_set_param command "$PROG" "$config_file"
	procd_set_param file "$config_file"
	procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param user valkey
	procd_close_instance
}

start_service() {
	# Create the Valkey user/group BEFORE loading and validating
	# the configuration.
	ensure_valkey_user || return 1

	config_load 'valkey'
	config_foreach valkey_instance 'instance'
}

service_triggers() {
	procd_add_reload_trigger "valkey"
	procd_add_validation validate_valkey_section
}

stop_service() {
	rm -f /tmp/valkey*.sock
}
